#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# =================================================================
# COMMIT MESSAGE VALIDATION
# =================================================================
# Enforce conventional commit format (optional but recommended)
# Format: <type>(<scope>): <subject>
# Example: feat(auth): add OAuth support

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Skip merge commits and reverts
if echo "$commit_msg" | grep -qE "^(Merge|Revert)"; then
  exit 0
fi

# Allow emoji commits (like the one we just made)
if echo "$commit_msg" | grep -qE "^(🔒|✨|🐛|📝|🚀|♻️|⚡|🎨|🔧|✅|🧪)"; then
  exit 0
fi

# Optional: Enforce conventional commits
