{
  "version": "2.0",
  "name": "extract-edn-uness-complete",
  "description": "Extraction complète des items EDN depuis UNESS avec authentification CAS",

  "defaultConfig": {
    "maxRetries": 3,
    "retryDelayMs": 2000,
    "requestDelayMs": 2000,
    "timeout": 30000,
    "batchSize": 10
  },

  "urls": {
    "casLogin": "https://auth.uness.fr/cas/login",
    "livretBase": "https://livret.uness.fr/lisa/2025",
    "itemsPage": "https://livret.uness.fr/lisa/2025/Item_de_connaissance_2C",
    "itemTemplate": "https://livret.uness.fr/lisa/2025/Item_de_connaissance_2C/Item_{id}"
  },

  "extraction": {
    "printableUrls": [
      "/version_imprimable",
      "?printable=yes",
      "&printable=yes",
      "/print"
    ],
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
  },

  "validation": {
    "minIntituleLength": 10,
    "minContentLength": 100,
    "minObjectiveLength": 15,
    "minWordCount": 3,
    "validityThreshold": 40,
    "scoring": {
      "shortIntitule": -20,
      "noRangs": -30,
      "shortContent": -25,
      "genericRangs": -15
    }
  },

  "patterns": {
    "intitule": [
      "<h1[^>]*class=\"[^\"]*titre[^\"]*\"[^>]*>([^<]+)</h1>",
      "<h1[^>]*>([^<]+)</h1>",
      "<title[^>]*>([^<]+)</title>",
      "<div[^>]*class=\"[^\"]*intitule[^\"]*\"[^>]*>([^<]+)</div>"
    ],
    "sectionRangs": [
      "<div[^>]*class=\"[^\"]*rang[\\s_-]*{rang}[^\"]*\"[^>]*>([\\s\\S]*?)</div>",
      "<div[^>]*id=\"[^\"]*rang[\\s_-]*{rang}[^\"]*\"[^>]*>([\\s\\S]*?)</div>",
      "<h[2-6][^>]*>\\s*(?:Connaissances?\\s+)?(?:de\\s+)?Rang\\s+{rang}[^<]*</h[2-6]>([\\s\\S]*?)(?=<h[2-6][^>]*>\\s*(?:Connaissances?\\s+)?(?:de\\s+)?Rang\\s+[AB]|<h[12][^>]*>|$)",
      "<[^>]*>\\s*Rang\\s+{rang}\\s*[:\\-]?\\s*</[^>]*>([\\s\\S]*?)(?=<[^>]*>\\s*Rang\\s+[AB]\\s*|$)",
      "<table[^>]*>\\s*<[^>]*>\\s*Rang\\s+{rang}[^<]*<[^>]*>([\\s\\S]*?)</table>",
      "Rang\\s+{rang}[^<]*?</[^>]+>([\\s\\S]*?)(?=Rang\\s+[AB]|<h[1-6]|$)"
    ],
    "objectifs": [
      {
        "pattern": "<li[^>]*>([\\s\\S]*?)</li>",
        "priority": 1,
        "flags": "gi"
      },
      {
        "pattern": "<p[^>]*class=\"[^\"]*objectif[^\"]*\"[^>]*>([\\s\\S]*?)</p>",
        "priority": 2,
        "flags": "gi"
      },
      {
        "pattern": "<div[^>]*class=\"[^\"]*(?:objectif|connaissance)[^\"]*\"[^>]*>([\\s\\S]*?)</div>",
        "priority": 2,
        "flags": "gi"
      },
      {
        "pattern": "<td[^>]*>([\\s\\S]*?)</td>",
        "priority": 3,
        "flags": "gi"
      },
      {
        "pattern": "<p[^>]*>([\\s\\S]*?)</p>",
        "priority": 4,
        "flags": "gi"
      }
    ],
    "excludeObjectifs": [
      "^(rang|objectif|connaissance|item)\\s*$",
      "^\\s*[a-z]\\s*$",
      "^[\\s\\d\\-•*]+$",
      "^(table des matières|sommaire|introduction)",
      "^\\s*(voir|cf\\.|référence)\\s"
    ]
  },

  "database": {
    "table": "edn_items_uness",
    "fields": [
      "item_id",
      "intitule",
      "rangs_a",
      "rangs_b",
      "contenu_complet_html",
      "date_import",
      "extraction_status",
      "quality_score"
    ]
  },

  "logging": {
    "levels": {
      "DEBUG": "🔍",
      "INFO": "📋",
      "WARN": "⚠️",
      "ERROR": "❌"
    },
    "includeTimestamp": true,
    "includeData": true
  },

  "monitoring": {
    "metricsEnabled": true,
    "trackProcessingTime": true,
    "trackQualityScore": true,
    "sampleSize": 5
  },

  "errorCodes": {
    "MISSING_CREDENTIALS": {
      "code": "MISSING_CREDENTIALS",
      "message": "Credentials UNESS manquants (username/password)",
      "retryable": false
    },
    "CAS_LOGIN_PAGE_ERROR": {
      "code": "CAS_LOGIN_PAGE_ERROR",
      "message": "Impossible d'accéder à la page de connexion CAS",
      "retryable": true
    },
    "CAS_AUTH_FAILED": {
      "code": "CAS_AUTH_FAILED",
      "message": "Échec de l'authentification CAS",
      "retryable": false
    },
    "CAS_ERROR": {
      "code": "CAS_ERROR",
      "message": "Erreur lors de l'authentification CAS",
      "retryable": true
    },
    "ITEMS_PAGE_ERROR": {
      "code": "ITEMS_PAGE_ERROR",
      "message": "Impossible d'accéder à la page des items",
      "retryable": true
    },
    "ITEM_UNAUTHORIZED": {
      "code": "ITEM_UNAUTHORIZED",
      "message": "Item non accessible - Authentification requise",
      "retryable": true
    },
    "ITEM_NOT_FOUND": {
      "code": "ITEM_NOT_FOUND",
      "message": "Item non trouvé",
      "retryable": false
    },
    "UNKNOWN_ERROR": {
      "code": "UNKNOWN_ERROR",
      "message": "Erreur inconnue",
      "retryable": true
    }
  },

  "features": {
    "enableRetry": true,
    "enableValidation": true,
    "enableMetrics": true,
    "enableQualityScore": true,
    "enableDeduplication": true,
    "enablePrintableVersion": true,
    "enableFallback": true
  },

  "limits": {
    "maxItemsPerRequest": 100,
    "maxContentLength": 1000000,
    "maxRangsPerItem": 500,
    "minItemId": 1,
    "maxItemId": 1000
  }
}
