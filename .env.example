# 🔒 CONFIGURATION SÉCURISÉE - AUCUNE VALEUR RÉELLE ICI
# ⚠️  IMPORTANT: Ne JAMAIS commiter le fichier .env avec des vraies valeurs
# Copiez ce fichier en .env et remplacez par vos vraies valeurs

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Documentation: https://supabase.com/docs/guides/getting-started
SUPABASE_URL=__TO_DEFINE__                    # Ex: https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__TO_DEFINE__       # ⚠️  CRITIQUE: Clé admin - ne JAMAIS exposer côté client
SUPABASE_ANON_KEY=__TO_DEFINE__               # Clé publique pour authentification client

# =============================================================================
# CAS AUTHENTICATION (UNESS)
# =============================================================================
# ⚠️  OBLIGATOIRE pour les fonctions d'extraction de contenu médical
# Utiliser CAS_USERNAME et CAS_PASSWORD (les autres sont des alias legacy)
CAS_USERNAME=__TO_DEFINE__                    # Username CAS principal
CAS_PASSWORD=__TO_DEFINE__                    # Password CAS principal

# ⚠️  DEPRECATED: Aliases legacy (utiliser CAS_USERNAME/CAS_PASSWORD à la place)
UNES_EMAIL=__TO_DEFINE__                      # Alias de CAS_USERNAME
UNES_PASSWORD=__TO_DEFINE__                   # Alias de CAS_PASSWORD
CAS_USER=__TO_DEFINE__                        # Alias de CAS_USERNAME
CAS_PASS=__TO_DEFINE__                        # Alias de CAS_PASSWORD

# =============================================================================
# EXTERNAL APIs
# =============================================================================
# ⚠️  SÉCURITÉ: Ne JAMAIS exposer ces clés côté client
OPENAI_API_KEY=__TO_DEFINE__                  # API OpenAI pour chat médical IA
SUNO_API_KEY=__TO_DEFINE__                    # API Suno pour génération musicale
RESEND_API_KEY=__TO_DEFINE__                  # API Resend pour envoi d'emails

# =============================================================================
# EMOTIONSCARE INTEGRATION (SSO)
# =============================================================================
VITE_EMOTIONSCARE_URL=https://app.emotionscare.com  # URL de l'application EmotionsCare

# =============================================================================
# ALERTING & MONITORING
# =============================================================================
ALERT_EMAIL=__TO_DEFINE__                     # Email pour recevoir les alertes système
DISCORD_WEBHOOK_URL=__TO_DEFINE__             # Webhook Discord pour notifications
SLACK_WEBHOOK_URL=__TO_DEFINE__               # Webhook Slack pour notifications
SENTRY_DSN=__TO_DEFINE__                      # Sentry DSN pour tracking d'erreurs

# =============================================================================
# SECURITY
# =============================================================================
JWT_SECRET=__TO_DEFINE__                      # Secret JWT pour signature des tokens

# =============================================================================
# CORS CONFIGURATION (Backend Express)
# =============================================================================
# 🔴 CRITIQUE EN PRODUCTION: Ne JAMAIS utiliser '*' en production !
# Liste d'origines autorisées séparées par des virgules
#
# DÉVELOPPEMENT:
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
#
# PRODUCTION (exemple):
# ALLOWED_ORIGINS=https://app.med-mng.com,https://www.med-mng.com
#
# ⚠️  SÉCURITÉ: La valeur '*' autorise TOUTES les origines (dangereux)
ALLOWED_ORIGINS=*

# =============================================================================
# BATCH PROCESSING CONFIGURATION (Supabase Functions)
# =============================================================================
# Nombre d'items traités par lot dans la fonction unified-extract
# Valeur recommandée: entre 5 et 50 selon les ressources disponibles
# Valeur par défaut: 10
BATCH_SIZE=10

# =============================================================================
# 📚 DOCUMENTATION SUPPLÉMENTAIRE
# =============================================================================
# - Guide de sécurité: docs/SECURITY.md
# - Configuration production: docs/DEPLOYMENT.md
# - Troubleshooting: docs/TROUBLESHOOTING.md
