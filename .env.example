# Med Music Platform Environment Configuration
# Copy this file to .env and fill in your values

# ===================================
# REQUIRED CONFIGURATION
# ===================================

# Application Environment
NODE_ENV=development
PORT=3000
SITE_URL=https://med-mng.com

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://yaincoxihiqdksxgrsrk.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlhaW5jb3hpaGlxZGtzeGdyc3JrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDI4MTE4MjcsImV4cCI6MjA1ODM4NzgyN30.HBfwymB2F9VBvb3uyeTtHBMZFZYXzL0wQmS5fqd65yU

# ===================================
# PRODUCTION/STAGING REQUIRED
# ===================================

# Supabase Service Role Key (Required for production/staging)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===================================
# SECURITY CONFIGURATION
# ===================================

# JWT Secret (Required for production - minimum 32 characters)
JWT_SECRET=your-super-secure-jwt-secret-at-least-32-characters-long-random-string

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-domain.com

# Proxy Configuration (for load balancers)
TRUST_PROXY=1

# Payload Limits (DoS Protection - MB)
MAX_PAYLOAD_MB=1

# ===================================
# RATE LIMITING & SECURITY
# ===================================

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===================================
# EXTERNAL API KEYS (OPTIONAL)
# ===================================

# OpenAI API Key (for AI features)
OPENAI_API_KEY=sk-your-openai-key-here

# Suno AI API Key (for music generation)
SUNO_API_KEY=your-suno-api-key-here

# Resend API Key (for emails)
RESEND_API_KEY=re_your-resend-key-here

# ===================================
# LOGGING & MONITORING
# ===================================

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Error Monitoring (Optional but recommended for production)
SENTRY_DSN=https://your-sentry-dsn@o123456.ingest.sentry.io/123456
VITE_SENTRY_DSN=https://your-sentry-dsn@o123456.ingest.sentry.io/123456
APP_VERSION=1.0.0
BUILD_SHA=local-dev
BUILD_TIMESTAMP=2024-01-01T00:00:00.000Z

# Alerting Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-url
ALERT_EMAIL=alerts@your-domain.com
ALERT_FROM_EMAIL=MedMNG Alerts <alerts@your-domain.com>
UPTIME_HEALTH_URL=https://your-domain.com/health
UPTIME_TIMEOUT_MS=5000
UPTIME_EXPECTED_STATUS=healthy

# ===================================
# EXTRACTION & CAS AUTHENTICATION
# ===================================

# CAS Authentication (for UNES/OIC extraction)
CAS_USERNAME=your-unes-username
CAS_PASSWORD=your-unes-password

# EDN/OIC Extraction Configuration
ENABLE_AUTO_EXTRACTION=false
EXTRACTION_SCHEDULE_CRON=0 2 * * *

# ===================================
# FEATURE FLAGS
# ===================================

# Core Features
ENABLE_MUSIC_GENERATION=true
ENABLE_REAL_TIME_FEATURES=true
ENABLE_ANALYTICS=true
ENABLE_CHAT_AI=true

# Experimental Features (use with caution in production)
ENABLE_BETA_FEATURES=false
ENABLE_DEBUG_MODE=false

# ===================================
# DEVELOPMENT/TESTING OPTIONS
# ===================================

# Development Options (DO NOT use in production)
SKIP_ENV_VALIDATION=false
MOCK_EXTERNAL_APIS=false

# Testing Configuration
TEST_SUPABASE_URL=https://test.supabase.co
TEST_SUPABASE_ANON_KEY=test-anon-key

# ===================================
# PERFORMANCE & OPTIMIZATION
# ===================================

# Cache Configuration (Redis - Optional)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# CDN Configuration (Optional)
CDN_BASE_URL=https://cdn.yourdomain.com

# Database Connection Pool (for high traffic)
DB_POOL_SIZE=20
DB_POOL_TIMEOUT=30000

# ===================================
# ANALYTICS & BUSINESS METRICS
# ===================================

# Google Analytics (Optional)
GA_TRACKING_ID=G-XXXXXXXXXX

# Business Analytics
MIXPANEL_TOKEN=your-mixpanel-token
HOTJAR_ID=your-hotjar-id

# Payment Processing (Stripe - Optional)
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret

# ===================================
# DEPLOYMENT CONFIGURATION
# ===================================

# Build Configuration
BUILD_ANALYZE=false
BUILD_SOURCEMAP=true

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Backup Configuration (Production)
BACKUP_SCHEDULE_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=30
