# Med Music Platform Environment Configuration
# Copy this file to .env and fill in your values

# ===================================
# REQUIRED CONFIGURATION
# ===================================

# Application Environment
NODE_ENV=development
PORT=3000

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://yaincoxihiqdksxgrsrk.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlhaW5jb3hpaGlxZGtzeGdyc3JrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDI4MTE4MjcsImV4cCI6MjA1ODM4NzgyN30.HBfwymB2F9VBvb3uyeTtHBMZFZYXzL0wQmS5fqd65yU

# ===================================
# PRODUCTION/STAGING REQUIRED
# ===================================

# Supabase Service Role Key (Required for production/staging)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Security Configuration (Required for production)
JWT_SECRET=your-super-secure-jwt-secret-at-least-32-characters-long-random-string
CORS_ORIGIN=https://med-music-platform.com,https://app.med-music-platform.com

# ===================================
# EXTERNAL API KEYS (OPTIONAL)
# ===================================

# OpenAI API Key (for AI features)
OPENAI_API_KEY=sk-your-openai-key-here

# Suno AI API Key (for music generation)
SUNO_API_KEY=your-suno-api-key-here

# Resend API Key (for emails)
RESEND_API_KEY=re_your-resend-key-here

# ===================================
# RATE LIMITING & SECURITY
# ===================================

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===================================
# LOGGING & MONITORING
# ===================================

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Error Monitoring (Optional but recommended for production)
SENTRY_DSN=https://your-sentry-dsn@o123456.ingest.sentry.io/123456

# Alerting
ALERT_EMAIL=alerts@med-music-platform.com
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-url

# ===================================
# FEATURE FLAGS
# ===================================

# Core Features
ENABLE_MUSIC_GENERATION=true
ENABLE_REAL_TIME_FEATURES=true
ENABLE_ANALYTICS=true

# ===================================
# DEVELOPMENT/TESTING OPTIONS
# ===================================

# Development Options (DO NOT use in production)
SKIP_ENV_VALIDATION=false
MOCK_EXTERNAL_APIS=false
