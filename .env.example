# ⚠️  CONFIGURATION SÉCURISÉE - AUCUNE VALEUR RÉELLE ICI
# Copiez ce fichier en .env et remplacez par vos vraies valeurs

# Supabase Configuration
SUPABASE_URL=__TO_DEFINE__
SUPABASE_SERVICE_ROLE_KEY=__TO_DEFINE__
SUPABASE_ANON_KEY=__TO_DEFINE__

# CAS Authentication (UNESS) - OBLIGATOIRE pour extraction
CAS_USERNAME=__TO_DEFINE__
CAS_PASSWORD=__TO_DEFINE__
# Legacy aliases (same values as above)
UNES_EMAIL=__TO_DEFINE__
UNES_PASSWORD=__TO_DEFINE__
CAS_USER=__TO_DEFINE__
CAS_PASS=__TO_DEFINE__

# External APIs
OPENAI_API_KEY=__TO_DEFINE__
SUNO_API_KEY=__TO_DEFINE__
RESEND_API_KEY=__TO_DEFINE__

# EmotionsCare Integration (SSO)
VITE_EMOTIONSCARE_URL=https://app.emotionscare.com

# Alerting & Monitoring
ALERT_EMAIL=__TO_DEFINE__
DISCORD_WEBHOOK_URL=__TO_DEFINE__
SLACK_WEBHOOK_URL=__TO_DEFINE__
SENTRY_DSN=__TO_DEFINE__

# Security
JWT_SECRET=__TO_DEFINE__

# CORS Configuration (Backend Express)
# Liste d'origines autorisées séparées par des virgules
# Exemple: https://app.example.com,https://www.example.com
# Par défaut: '*' (tous les domaines - NON RECOMMANDÉ EN PRODUCTION)
ALLOWED_ORIGINS=*

# Batch Processing Configuration (Supabase Functions)
# Nombre d'items traités par lot dans la fonction unified-extract
# Valeur recommandée: entre 5 et 50 selon les ressources disponibles
BATCH_SIZE=10
