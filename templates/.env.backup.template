# ========================================
# Med-MNG Backup Configuration Template
# ========================================
# Copiez ce fichier vers .env.backup et remplissez vos valeurs
# NE PAS COMMITER CE FICHIER!

# Supabase Database
SUPABASE_DB_HOST=db.your-project.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_PASSWORD=your-database-password-here

# AWS S3 (pour backups off-site)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret-key-here
AWS_S3_BACKUP_BUCKET=med-mng-backups
AWS_DEFAULT_REGION=eu-west-1

# GPG (pour chiffrement des secrets)
GPG_PASSPHRASE=your-secure-passphrase-here

# Email Alerts
ALERT_EMAIL=backup-alerts@med-mng.fr

# Supabase CLI (optionnel - pour backups storage)
SUPABASE_ACCESS_TOKEN=sbp_...
