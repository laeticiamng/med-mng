# Configuration pour l'extraction des compétences OIC UNESS

# Supabase Configuration
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Authentification CAS UNESS
CAS_USERNAME=your_cas_username_here
CAS_PASSWORD=your_cas_password_here

# Configuration optionnelle
FORCE_UPDATE=false  # true pour re-extraction complète, false pour complétion uniquement