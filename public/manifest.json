{
  "name": "MED-MNG - Plateforme Médicale Intelligente",
  "short_name": "MED-MNG",
  "description": "Plateforme d'apprentissage médical révolutionnaire avec IA générative et contenus personnalisés",
  "start_url": "/med-mng/dashboard",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "fr-FR",
  "dir": "ltr",
  "categories": ["education", "medical", "productivity"],
  "screenshots": [
    {
      "src": "/screenshots/desktop-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Vue d'ensemble du dashboard MED-MNG"
    },
    {
      "src": "/screenshots/mobile-narrow.png",
      "sizes": "375x667",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Interface mobile MED-MNG"
    }
  ],
  "icons": [
    {
      "src": "/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Créer du contenu",
      "short_name": "Créer",
      "description": "Générer du nouveau contenu médical avec l'IA",
      "url": "/med-mng/create",
      "icons": [
        {
          "src": "/icons/create-shortcut.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Ma bibliothèque",
      "short_name": "Bibliothèque",
      "description": "Accéder à votre collection de contenus",
      "url": "/med-mng/library",
      "icons": [
        {
          "src": "/icons/library-shortcut.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Analyses",
      "short_name": "Stats",
      "description": "Suivre vos progrès d'apprentissage",
      "url": "/med-mng/analytics",
      "icons": [
        {
          "src": "/icons/analytics-shortcut.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://med-mng.com/manifest.json"
    }
  ],
  "prefer_related_applications": false,
  "features": [
    "offline-support",
    "push-notifications",
    "background-sync",
    "file-system-access"
  ],
  "file_handlers": [
    {
      "action": "/med-mng/import",
      "accept": {
        "audio/*": [".mp3", ".wav", ".ogg"],
        "application/json": [".json"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+medmng",
      "url": "/med-mng/open?url=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  }
}