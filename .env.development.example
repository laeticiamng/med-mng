# Development environment configuration
# Copy to .env.development and fill in your values

# Supabase Configuration (REQUIRED)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=__TO_DEFINE__
SUPABASE_ANON_KEY=__TO_DEFINE__

# Client-side Supabase (exposed to browser via Vite)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=__TO_DEFINE__

# CAS Authentication (UNESS) - Required for EDN extraction only
CAS_USERNAME=__TO_DEFINE__
CAS_PASSWORD=__TO_DEFINE__
UNESS_USERNAME=__TO_DEFINE__
UNESS_EMAIL=__TO_DEFINE__
UNESS_PASSWORD=__TO_DEFINE__
# Legacy aliases
UNES_EMAIL=__TO_DEFINE__
UNES_PASSWORD=__TO_DEFINE__
CAS_USER=__TO_DEFINE__
CAS_PASS=__TO_DEFINE__

# External APIs (optional in dev - features degrade gracefully)
OPENAI_API_KEY=__TO_DEFINE__
SUNO_API_KEY=__TO_DEFINE__
RESEND_API_KEY=__TO_DEFINE__
LOVABLE_API_KEY=__TO_DEFINE__
ELEVENLABS_API_KEY=__TO_DEFINE__

# Alerting & Monitoring (optional in dev)
ALERT_EMAIL=__TO_DEFINE__
ALERT_WEBHOOK_URL=__TO_DEFINE__
DISCORD_WEBHOOK_URL=__TO_DEFINE__
EMAIL_ALERT_ENDPOINT=__TO_DEFINE__
ERROR_ALERT_WEBHOOK_URL=__TO_DEFINE__
SLACK_WEBHOOK_URL=__TO_DEFINE__
TEAMS_WEBHOOK_URL=__TO_DEFINE__
PAGERDUTY_API_KEY=__TO_DEFINE__
PAGERDUTY_INTEGRATION_KEY=__TO_DEFINE__
NVD_API_KEY=__TO_DEFINE__
SENTRY_DSN=__TO_DEFINE__

# Notifications Web Push (optional in dev)
VAPID_PUBLIC_KEY=__TO_DEFINE__
VAPID_PRIVATE_KEY=__TO_DEFINE__
VAPID_SUBJECT=__TO_DEFINE__

# Payments (optional in dev - use Stripe test keys)
STRIPE_SECRET_KEY=__TO_DEFINE__
STRIPE_WEBHOOK_SECRET=__TO_DEFINE__
SHOPIFY_WEBHOOK_SECRET=__TO_DEFINE__

# Security
JWT_SECRET=dev-secret-change-me
