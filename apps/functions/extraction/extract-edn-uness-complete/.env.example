# ============================================================================
# EXTRACT EDN UNESS COMPLETE - Environment Variables
# ============================================================================
#
# Copier ce fichier en .env et remplir avec vos valeurs
# Ne JAMAIS commiter le fichier .env dans le repository
#

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================

# URL de votre projet Supabase
# Format: https://[PROJECT_ID].supabase.co
SUPABASE_URL=https://xxxxx.supabase.co

# Clé de service Supabase (Service Role Key)
# ⚠️ ATTENTION: Cette clé donne un accès complet à votre base de données
# Ne jamais exposer publiquement ou commiter dans git
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé anonyme Supabase (Anon Key) - optionnel
# Utilisée pour les appels clients
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# UNESS CREDENTIALS
# ============================================================================

# Email / Identifiant UNESS
# Utilisé pour l'authentification CAS
UNES_EMAIL=votre.email@uness.fr

# Mot de passe UNESS
# ⚠️ ATTENTION: Stocker de manière sécurisée
# Peut également être passé dans la requête API
UNES_PASSWORD=votre_mot_de_passe_securise

# ============================================================================
# CONFIGURATION OPTIONNELLE
# ============================================================================

# Nombre maximum de retries en cas d'échec (défaut: 3)
MAX_RETRIES=3

# Délai de base pour les retries en ms (défaut: 2000)
RETRY_DELAY_MS=2000

# Délai entre les requêtes en ms (défaut: 2000)
REQUEST_DELAY_MS=2000

# Timeout par requête en ms (défaut: 30000)
REQUEST_TIMEOUT=30000

# Taille de batch pour traitement (défaut: 10)
BATCH_SIZE=10

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Niveau de log (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Activer les métriques détaillées (true/false)
ENABLE_METRICS=true

# Activer le scoring de qualité (true/false)
ENABLE_QUALITY_SCORE=true

# ============================================================================
# FEATURES FLAGS
# ============================================================================

# Activer le retry automatique (true/false)
ENABLE_RETRY=true

# Activer la validation des données (true/false)
ENABLE_VALIDATION=true

# Activer la déduplication (true/false)
ENABLE_DEDUPLICATION=true

# Activer la version imprimable (true/false)
ENABLE_PRINTABLE_VERSION=true

# ============================================================================
# LIMITS & SECURITY
# ============================================================================

# Nombre maximum d'items par requête
MAX_ITEMS_PER_REQUEST=100

# Taille maximale du contenu HTML (bytes)
MAX_CONTENT_LENGTH=1000000

# Nombre maximum de rangs par item
MAX_RANGS_PER_ITEM=500

# ============================================================================
# NOTES
# ============================================================================
#
# 1. Variables REQUISES:
#    - SUPABASE_URL
#    - SUPABASE_SERVICE_ROLE_KEY
#    - UNES_EMAIL (ou passé dans la requête)
#    - UNES_PASSWORD (ou passé dans la requête)
#
# 2. Variables OPTIONNELLES:
#    - Toutes les autres variables ont des valeurs par défaut
#
# 3. Sécurité:
#    - Ne jamais commiter .env dans git
#    - Utiliser supabase secrets pour le déploiement:
#      supabase secrets set UNES_EMAIL=xxx
#      supabase secrets set UNES_PASSWORD=xxx
#
# 4. Pour le déploiement sur Supabase Edge Functions:
#    supabase secrets set SUPABASE_URL=xxx
#    supabase secrets set SUPABASE_SERVICE_ROLE_KEY=xxx
#    supabase secrets set UNES_EMAIL=xxx
#    supabase secrets set UNES_PASSWORD=xxx
#
# ============================================================================
